    <string name="tour_setup_welcome_title">Welkom bij Immich Media Frame</string>
    <string name="tour_setup_welcome_body">Maak verbinding met je Immich-server om je foto\'s te tonen. Laten we de installatie doorlopen.</string>
    <string name="tour_setup_server_title">Serveradres</string>
    <string name="tour_setup_server_body">Voer hier de URL van je Immich-server in. Gebruik de notatie photos.example.com of 192.168.1.100:2283.</string>
    <string name="tour_setup_apikey_title">API-sleutel</string>
    <string name="tour_setup_apikey_body">Maak een API-sleutel aan in Immich onder Instellingen → API-sleutels. Hiervoor zijn leesrechten nodig voor albums, assets en gebruikers.</string>
    <string name="tour_setup_connect_title">Testen en verbinden</string>
    <string name="tour_setup_connect_body">Tik op Verbinding testen om je inloggegevens te controleren. Na het verbinden kies je welke albums je wilt tonen.</string>
    <string name="tour_albums_select_title">Kies je albums</string>
    <string name="tour_albums_select_body">Tik op een of meer albums om ze toe te voegen aan je diavoorstelling. Geselecteerde albums tonen een vinkje.</string>
    <string name="tour_albums_start_title">Start de show</string>
    <string name="tour_albums_start_body">Als je je albums hebt gekozen, tik dan op Start diavoorstelling om te beginnen.</string>
    <string name="tour_albums_settings_title">Instellingen</string>
    <string name="tour_albums_settings_body">Open de instellingen altijd via dit tandwielpictogram — pas intervallen, klok, cache en meer aan.</string>
    <string name="tour_slideshow_tap_title">Tik om te bedienen</string>
    <string name="tour_slideshow_tap_body">Tik ergens op het scherm om de afspeelbediening te tonen of verbergen. Ze verbergen automatisch na enkele seconden.</string>
    <string name="tour_slideshow_nav_title">Door foto\'s bladeren</string>
    <string name="tour_slideshow_nav_body">Gebruik deze pijlen om handmatig naar de vorige of volgende foto te gaan.</string>
    <string name="tour_slideshow_playback_title">Pauze en dempen</string>
    <string name="tour_slideshow_playback_body">Pauzeer de diavoorstelling of demp video-audio met deze bediening.</string>
    <string name="tour_slideshow_media_selection_title">Kies je media</string>
    <string name="tour_slideshow_media_selection_body">"Tik hier om te kiezen welke media in de diavoorstelling verschijnen. Je bevestigt eerst met vingerafdruk of schermvergrendeling."</string>
        <string name="tour_slideshow_albums_title">Terug naar Albums</string>
    <string name="tour_slideshow_albums_body">Andere foto\'s kiezen? Tik hier om terug te gaan naar albumselectie.</string>
    <string name="tour_slideshow_update_title">Update-indicator</string>
    <string name="tour_slideshow_update_body">Als er een update beschikbaar is, verschijnt dit icoon hier zodat u de nieuwste versie kunt installeren. Als het niet zichtbaar is, bent u al up-to-date.</string>
<string name="tour_slideshow_settings_title">Direct aanpassen</string>
    <string name="tour_slideshow_settings_body">Open de instellingen zonder de diavoorstelling te verlaten — wijzig interval, schakel de klok in en meer.</string>
    <string name="tour_slideshow_close_title">Diavoorstelling sluiten</string>
    <string name="tour_slideshow_close_body">Tik hier om de diavoorstelling te sluiten en terug te keren naar de albumselectie.</string>
    <string name="tour_settings_overview_title">Overzicht instellingen</string>
    <string name="tour_settings_overview_body">Alle wijzigingen worden automatisch opgeslagen — geen opslanknop nodig. Scroll naar beneden om elke sectie te verkennen.</string>
    <string name="tour_settings_system_title">Systeem en autostart</string>
    <string name="tour_settings_system_body">Opstarten bij opstart en Launcher-modus laten de app automatisch starten — ideaal voor speciale fotolijsten.</string>
    <string name="tour_settings_cache_title">Mediacache</string>
    <string name="tour_settings_cache_body">Auto Sync downloadt foto\'s op de achtergrond zodat de diavoorstelling offline werkt en direct laadt.</string>
    <string name="tour_settings_connection_title">Verbinding</string>
    <string name="tour_settings_connection_body">Werk hier je server-URL of API-sleutel bij als je Immich-instellingen veranderen.</string>

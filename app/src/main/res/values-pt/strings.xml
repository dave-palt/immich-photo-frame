    <string name="autostart_perm_title">Permissão de arranque automático</string>
    <string name="autostart_perm_message">Alguns dispositivos impedem as aplicações de iniciarem automaticamente. Para garantir que a aplicação é iniciada no arranque, pode ser necessário conceder permissão de arranque automático nas definições do dispositivo.</string>
    <string name="overlay_perm_title">Exibir sobre outras apps</string>
    <string name="overlay_perm_message">Para iniciar a app automaticamente após o reinício, o Android requer a permissão "Exibir sobre outras apps". Conceda-a no ecrã de definições que se abre.</string>
    <string name="open_overlay">Conceder Exibir sobre outras apps</string>
        <string name="launcher_mode">Modo Launcher</string>
        <string name="launcher_mode_desc">Definir como ecrã inicial predefinido. A forma mais fiável de iniciar no arranque — sem permissão de autostart. Ideal para molduras digitais dedicadas.</string>
